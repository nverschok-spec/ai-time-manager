# Скопируй этот файл в .env.local и впиши реальный ключ.
# .env.local уже в .gitignore — не попадёт в git и не попадёт в клиентский код,
# т.к. используется только внутри /api/ai-parse.js (serverless-функция).

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Общий PIN-код для входа в приложение (любая цифровая или буквенная строка).
# Без этой переменной защита PIN отключена — /api/ai-parse будет работать без токена.
APP_PIN=123456
